import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        int[] arr = new int[n];

        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        int[] result = Arrays.stream(arr)
                .boxed()
                .reduce(
                    new int[]{0, Integer.MIN_VALUE},
                    (a, x) -> {
                        a[0] = Math.max(x, a[0] + x);
                        a[1] = Math.max(a[1], a[0]);
                        return a;
                    },
                    (a, b) -> a
                );

        System.out.println(result[1]);
    }
}


Sample Input
8
-2 -3 4 -1 -2 1 5 -3
Sample Output
7
